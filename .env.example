# Solana cluster the app talks to. Build and test on devnet first —
# the DBC program ID is identical on both clusters.
NEXT_PUBLIC_SOLANA_CLUSTER=devnet
NEXT_PUBLIC_RPC_ENDPOINT=https://api.devnet.solana.com

# Postgres connection string for the indexer + API routes.
# Supabase's free tier works well: Project Settings -> Database -> Connection string (URI).
DATABASE_URL=postgresql://user:password@localhost:5432/dbc_launch_studio

# How often the standalone indexer polls on-chain state, in milliseconds.
INDEXER_POLL_MS=15000
